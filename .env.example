# --- Supabase -----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only. Used for Auth admin (invites) and wallet-pass sync writes.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# --- App ----------------------------------------------------------------------
# Public origin, used in QR code URLs and auth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# >= 32 random chars. Hashes device cookies before they reach the DB.
# Generate: openssl rand -hex 32   (rotating it resets every customer's card)
DEVICE_HASH_SECRET=replace-with-64-hex-chars

# --- Wallet passes -------------------------------------------------------------
# "mock" (local dev, no network) or "walletwallet"
WALLET_PROVIDER=mock
WALLETWALLET_API_KEY=
# Optional override, defaults to https://api.walletwallet.dev
WALLETWALLET_API_URL=

# --- scripts/bootstrap-users.ts (local/dev only) ---------------------------------
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@hyperfid.tn
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_MERCHANT_EMAIL=mandy@hyperfid.tn
BOOTSTRAP_MERCHANT_PASSWORD=
